@using MvcStok.Models.Entity
@model List<Musteriler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>id</th>
            <th>AD</th>
            <th>Soyad</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var mus in Model)
            {
                <tr>
                    <td>@mus.MüsteriId</td>
                    <td>@mus.MusteriAD</td>
                    <td>@mus.MusteriSoyad</td>
                    <td><a href="/Musteri/Sil/@mus.MüsteriId" class="btn btn-danger">Sil</a></td>
                    <td><a href="/Musteri/Guncelle/@mus.MüsteriId" class="btn btn-warning">Güncelle</a></td>
                </tr>
            }
    </tbody>
</table>
<a href="/Musteri/Ekle" class="btn btn-primary">Ekle</a>



