@using MvcStok.Models.Entity;
@model List<Kategoriler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var i in Model)
            {
                <tr>
                    <td>@i.KategoriId</td>
                    <td>@i.KategoriAdi</td>
                    <td><a href="/Kategori/Sil/@i.KategoriId" class="btn btn-danger">Sil</a></td>
                    <td><a href="/Kategori/Guncelle/@i.KategoriId" class="btn btn-warning">Güncelle</a></td>
                </tr>
            }
    </tbody>
</table>
<a href="/Kategori/Ekle" class="btn btn-primary">Kategori Ekle</a>

