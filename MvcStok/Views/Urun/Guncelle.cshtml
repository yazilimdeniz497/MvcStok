@model MvcStok.Models.Entity.Urunler
@{
    ViewBag.Title = "Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post">
    <div class="mb-3">
        <label for="Urunid">Urunid</label>
        @Html.TextBoxFor(x => x.UrunId, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label for="Urunadi">Urunadi</label>
        @Html.TextBoxFor(x => x.Urunadi, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label for="Marka">Marka</label>
        @Html.TextBoxFor(x => x.Marka, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label for="UrunKategori">Kategori Seçiniz:</label>
        @Html.DropDownListFor(x => x.UrunKategori, (List<SelectListItem>)ViewBag.dgr1, new { @class = "form-control" });
    </div>
    <div class="mb-3">
        <label for="Urunstok">Urunstok:</label>
        @Html.TextBoxFor(x => x.Urunstok, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label for="UrunFiyat">UrunFiyat:</label>
        @Html.TextBoxFor(x => x.UrunFiyat, new { @class = "form-control" })
    </div>
    <button type="submit" class="btn btn-warning">Güncelle</button>
</form>

